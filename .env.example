# Artemis Mission Simulation — environment configuration
# Copy to .env and adjust values for your setup.

# --- LLM ---
# Provider: "openai" | "anthropic" | "local"
ARTEMIS_LLM_PROVIDER=local
# For local (llama.cpp / ollama / vLLM), set model path or name:
ARTEMIS_LLM_MODEL=your-model-name
ARTEMIS_LLM_BASE_URL=http://localhost:8100/v1
ARTEMIS_LLM_API_KEY=not-needed
# For OpenAI / Anthropic, set the real key instead:
# ARTEMIS_LLM_API_KEY=sk-...

# --- Auth ---
# Set to true to bypass Keycloak (uses X-Simulation-Role header instead)
ARTEMIS_AUTH_DISABLED=true

# --- Database ---
# Only needed if not using docker-compose defaults
# ARTEMIS_DATABASE_URL=postgresql+asyncpg://artemis:artemis@localhost:5432/artemis

# --- Debug ---
ARTEMIS_DEBUG=true
